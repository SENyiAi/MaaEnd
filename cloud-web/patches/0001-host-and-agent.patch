diff --git a/agent/cpp-algo/cloud-webview/transport/win_key_identity.h b/agent/cpp-algo/cloud-webview/transport/win_key_identity.h
new file mode 100644
index 0000000000000000000000000000000000000000..c2baf8fe8f5c3933f0f721e7ea7b9b2a349865a5
--- /dev/null
+++ b/agent/cpp-algo/cloud-webview/transport/win_key_identity.h
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <utility>
+
+// PI PC keycodes use Windows virtual-key values. Keep the CDP translation free
+// of platform headers so it can be verified without a WebView or game session.
+inline std::pair<std::string, std::string> cloud_key_identity(int32_t code)
+{
+    if (code >= 'A' && code <= 'Z') {
+        return { std::string(1, static_cast<char>(code - 'A' + 'a')), "Key" + std::string(1, static_cast<char>(code)) };
+    }
+    if (code >= '0' && code <= '9') {
+        const auto digit = std::string(1, static_cast<char>(code));
+        return { digit, "Digit" + digit };
+    }
+    if (code >= 112 && code <= 135) {
+        const auto function_key = "F" + std::to_string(code - 112 + 1);
+        return { function_key, function_key };
+    }
+    switch (code) {
+    case 8:
+        return { "Backspace", "Backspace" };
+    case 27:
+        return { "Escape", "Escape" };
+    case 13:
+        return { "Enter", "Enter" };
+    case 32:
+        return { " ", "Space" };
+    case 9:
+        return { "Tab", "Tab" };
+    case 16:
+    case 160:
+        return { "Shift", "ShiftLeft" };
+    case 161:
+        return { "Shift", "ShiftRight" };
+    case 17:
+    case 162:
+        return { "Control", "ControlLeft" };
+    case 163:
+        return { "Control", "ControlRight" };
+    case 18:
+    case 164:
+        return { "Alt", "AltLeft" };
+    case 165:
+        return { "Alt", "AltRight" };
+    case 91:
+        return { "Meta", "MetaLeft" };
+    case 92:
+        return { "Meta", "MetaRight" };
+    case 38:
+        return { "ArrowUp", "ArrowUp" };
+    case 40:
+        return { "ArrowDown", "ArrowDown" };
+    case 37:
+        return { "ArrowLeft", "ArrowLeft" };
+    case 39:
+        return { "ArrowRight", "ArrowRight" };
+    case 19:
+        return { "Pause", "Pause" };
+    case 20:
+        return { "CapsLock", "CapsLock" };
+    case 33:
+        return { "PageUp", "PageUp" };
+    case 34:
+        return { "PageDown", "PageDown" };
+    case 35:
+        return { "End", "End" };
+    case 36:
+        return { "Home", "Home" };
+    case 45:
+        return { "Insert", "Insert" };
+    case 46:
+        return { "Delete", "Delete" };
+    case 144:
+        return { "NumLock", "NumLock" };
+    case 145:
+        return { "ScrollLock", "ScrollLock" };
+    case 186:
+        return { ";", "Semicolon" };
+    case 187:
+        return { "=", "Equal" };
+    case 188:
+        return { ",", "Comma" };
+    case 189:
+        return { "-", "Minus" };
+    case 190:
+        return { ".", "Period" };
+    case 191:
+        return { "/", "Slash" };
+    case 192:
+        return { "`", "Backquote" };
+    case 219:
+        return { "[", "BracketLeft" };
+    case 220:
+        return { "\\", "Backslash" };
+    case 221:
+        return { "]", "BracketRight" };
+    case 222:
+        return { "'", "Quote" };
+    default:
+        return {};
+    }
+}
diff --git a/agent/cpp-algo/cloud-webview/video_frame_policy.h b/agent/cpp-algo/cloud-webview/video_frame_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..c67e9ff4e945ad3f11835d7cd49035cee9b10b7a
--- /dev/null
+++ b/agent/cpp-algo/cloud-webview/video_frame_policy.h
@@ -0,0 +1,58 @@
+#pragma once
+
+namespace cloud
+{
+
+inline constexpr char kCaptureVideoPng[] = R"JS(
+(() => {
+    const video = [...document.querySelectorAll('video')].find(v =>
+        v.isConnected && v.readyState >= 2 && !v.paused && !v.ended && v.videoWidth > 0);
+    if (!video) return null;
+    const canvas = document.createElement('canvas');
+    canvas.width = 1280; canvas.height = 720;
+    canvas.getContext('2d', {alpha: false}).drawImage(video, 0, 0, 1280, 720);
+    return {data: canvas.toDataURL('image/png').split(',')[1],
+        media_time: video.currentTime,
+        decoded_frames: video.getVideoPlaybackQuality().totalVideoFrames};
+})()
+)JS";
+
+// Installed lazily in the current document, so a normal navigation discards all
+// stream state. Pixels always come from the site's existing decoded video.
+inline constexpr char kCaptureVideoFrame[] = R"JS(
+(() => {
+    const video = [...document.querySelectorAll('video')].find(v =>
+        v.isConnected && v.readyState >= 2 && !v.paused && !v.ended && v.videoWidth > 0);
+    if (!video) return null;
+    if (!Object.hasOwn(window, '__maaEndVideoFrame')) {
+        let pixels = null;
+        let receive;
+        const ready = new Promise(resolve => { receive = resolve; });
+        const canvas = document.createElement('canvas');
+        canvas.width = 1280; canvas.height = 720;
+        const context = canvas.getContext('2d', {alpha: false, willReadFrequently: true});
+        chrome.webview.addEventListener('sharedbufferreceived', event => {
+            if (event.additionalData?.purpose !== 'maaend-video-frame') return;
+            pixels = new Uint8Array(event.getBuffer());
+            receive();
+        });
+        Object.defineProperty(window, '__maaEndVideoFrame', {value: {
+            get ready() { return pixels !== null; },
+            capture: async () => {
+                await ready;
+                const v = [...document.querySelectorAll('video')].find(v =>
+                    v.isConnected && v.readyState >= 2 && !v.paused && !v.ended && v.videoWidth > 0);
+                if (!v) return null;
+                context.drawImage(v, 0, 0, 1280, 720);
+                pixels.set(context.getImageData(0, 0, 1280, 720).data);
+                return {media_time: v.currentTime,
+                    decoded_frames: v.getVideoPlaybackQuality().totalVideoFrames,
+                    width: 1280, height: 720, stride: 5120, format: 'RGBA8'};
+            }
+        }});
+    }
+    return window.__maaEndVideoFrame.ready ? window.__maaEndVideoFrame.capture() : {needs_buffer: true};
+})()
+)JS";
+
+} // namespace cloud
diff --git a/agent/cpp-algo/cloud-webview/win32_bridge_protocol.h b/agent/cpp-algo/cloud-webview/win32_bridge_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..d343b9b2c8c6c81aef83b0619ea0c2618c1225d4
--- /dev/null
