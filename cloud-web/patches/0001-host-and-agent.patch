@@ -0,0 +1,151 @@
+#include <iostream>
+#include <tuple>
+#include <vector>
+
+#include "CloudInput.h"
+#include "win_key_identity.h"
+
+class RecordingTransport final : public CloudTransport
+{
+public:
+    bool connect() override { return true; }
+
+    bool capture(CloudFrame&) override { return false; }
+
+    bool insert_text(const std::string&) override { return false; }
+
+    bool mouse(const CloudMouseEvent& event) override
+    {
+        mouse_events.push_back(event);
+        return success;
+    }
+
+    bool key(int32_t code, bool down, int32_t modifiers, bool repeated) override
+    {
+        key_events.emplace_back(code, down, modifiers, repeated);
+        return success;
+    }
+
+    bool relative_move(int32_t, int32_t, int32_t buttons, int32_t modifiers) override
+    {
+        relative_buttons = buttons;
+        relative_modifiers = modifiers;
+        return success;
+    }
+
+    bool success = true;
+    int32_t relative_buttons = 0;
+    int32_t relative_modifiers = 0;
+    std::vector<CloudMouseEvent> mouse_events;
+    std::vector<std::tuple<int32_t, bool, int32_t, bool>> key_events;
+};
+
+int main()
+{
+    int checks = 0;
+    int failures = 0;
+    const auto expect = [&](bool result, const char* scenario) {
+        ++checks;
+        if (!result) {
+            std::cerr << "FAIL: " << scenario << '\n';
+            ++failures;
+        }
+    };
+    // Values accepted by the GUI must retain their physical CDP key codes.
+    const std::vector<std::tuple<int32_t, std::string, std::string>> mapped_keys {
+        { 19, "Pause", "Pause" },
+        { 20, "CapsLock", "CapsLock" },
+        { 33, "PageUp", "PageUp" },
+        { 34, "PageDown", "PageDown" },
+        { 35, "End", "End" },
+        { 36, "Home", "Home" },
+        { 45, "Insert", "Insert" },
+        { 46, "Delete", "Delete" },
+        { 144, "NumLock", "NumLock" },
+        { 145, "ScrollLock", "ScrollLock" },
+        { 186, ";", "Semicolon" },
+        { 187, "=", "Equal" },
+        { 188, ",", "Comma" },
+        { 189, "-", "Minus" },
+        { 190, ".", "Period" },
+        { 191, "/", "Slash" },
+        { 192, "`", "Backquote" },
+        { 219, "[", "BracketLeft" },
+        { 220, "\\", "Backslash" },
+        { 221, "]", "BracketRight" },
+        { 222, "'", "Quote" },
+        { 27, "Escape", "Escape" },
+        { 65, "a", "KeyA" },
+        { 90, "z", "KeyZ" },
+        { 48, "0", "Digit0" },
+        { 57, "9", "Digit9" },
+        { 112, "F1", "F1" },
+        { 135, "F24", "F24" },
+        { 161, "Shift", "ShiftRight" },
+        { 163, "Control", "ControlRight" },
+        { 165, "Alt", "AltRight" },
+    };
+    for (const auto& [value, key, code] : mapped_keys) {
+        expect(cloud_key_identity(value) == std::pair { key, code }, code.c_str());
+    }
+    expect(cloud_key_identity(-1).first.empty() && cloud_key_identity(255).first.empty(), "unknown keys are rejected");
+    RecordingTransport transport;
+    CloudInput input(transport);
+    expect(input.touchDown(-1, 100, 200) && input.touchUp(-1) && transport.mouse_events.empty(), "hover cannot press a button");
+    expect(input.touchMove(-1, 100, 200) && transport.mouse_events.back().buttons == 0, "hover moves with no held buttons");
+    expect(!input.touchDown(31, 0, 0) && !input.touchMove(-2, 0, 0) && !input.touchUp(3), "invalid contacts cannot be shifted");
+    expect(
+        input.touchDown(0, 100, 200) && input.touchDown(1, 300, 400) && transport.mouse_events.back().buttons == 3,
+        "simultaneous left and right presses preserve both buttons");
+    expect(
+        input.touchMove(1, 310, 410) && transport.mouse_events.back().buttons == 3 && transport.mouse_events.back().contact == -1,
+        "drag move retains buttons and uses no changed button");
+    expect(
+        input.touchUp(1) && transport.mouse_events.back().x == 310 && transport.mouse_events.back().y == 410
+            && transport.mouse_events.back().buttons == 1,
+        "release uses the last drag position without releasing other buttons");
+    expect(
+        input.touchMove(-1, 500, 600) && input.touchUp(0) && transport.mouse_events.back().x == 500
+            && transport.mouse_events.back().y == 600 && transport.mouse_events.back().buttons == 0,
+        "Win32 hover-contact moves update the held button release position");
+    input.touchDown(0, 500, 600);
+    expect(
+        input.key(16, true) && input.key('W', true) && std::get<2>(transport.key_events.back()) == 8,
+        "Shift modifier is included with W");
+    expect(input.key('W', true) && std::get<3>(transport.key_events.back()), "held key reports auto-repeat");
+    expect(
+        input.relativeMove(20, -5) && transport.relative_buttons == 1 && transport.relative_modifiers == 8,
+        "relative camera input retains held button and key state");
+    expect(
+        input.scroll(0, 100) && transport.mouse_events.back().buttons == 1 && transport.mouse_events.back().modifiers == 8,
+        "scroll retains held buttons and modifiers");
+    expect(
+        input.releaseAll() && transport.mouse_events.back().buttons == 0 && std::get<1>(transport.key_events.back()) == false,
+        "inactive releases every key and button");
+    const auto idle_events = transport.mouse_events.size() + transport.key_events.size();
+    expect(
+        input.releaseAll() && transport.mouse_events.size() + transport.key_events.size() == idle_events,
+        "inactive with no held state emits no input");
+
+    transport.success = false;
+    expect(!input.touchDown(2, 10, 20) && !input.key(27, true), "failed press is reported");
+    expect(!input.releaseAll(), "failed releases remain pending");
+    transport.success = true;
+    expect(
+        input.releaseAll() && transport.mouse_events.back().action == CloudMouseAction::Release && transport.mouse_events.back().x == 10
+            && std::get<0>(transport.key_events.back()) == 27 && !std::get<1>(transport.key_events.back()),
+        "uncertain presses can still be released after a transport failure");
+    {
+        CloudInput temporary(transport);
+        temporary.touchDown(0, 12, 34);
+        temporary.key('A', true);
+    }
+    expect(
+        transport.mouse_events.back().action == CloudMouseAction::Release && !std::get<1>(transport.key_events.back()),
+        "destruction releases held input before transport teardown");
+    if (failures) {
+        return 1;
+    }
+    std::cout << "Cloud input: " << checks << " checks passed.\n";
+    return 0;
+}
diff --git a/agent/cpp-algo/cloud-webview/tests/mouse_policy.test.mjs b/agent/cpp-algo/cloud-webview/tests/mouse_policy.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..54edcf8792e40c82309f2ddfe9b61c36284b4933
--- /dev/null
+++ b/agent/cpp-algo/cloud-webview/tests/mouse_policy.test.mjs
@@ -0,0 +1,285 @@
+import assert from "node:assert/strict";
+import {readFileSync} from "node:fs";
+import test from "node:test";
+import vm from "node:vm";
+
+const source = readFileSync(new URL("../input_policy.h", import.meta.url), "utf8");
+const script = source.match(/LR"JS\(([\s\S]*?)\)JS";/)?.[1];
+assert.ok(script);
+
+function browser({video = null, menu = null, layer = null, hitTest = null} = {}) {
+    const listeners = new Map();
+    const window = {
+        addEventListener(type, callback) {
+            const callbacks = listeners.get(type) ?? [];
+            callbacks.push(callback);
+            listeners.set(type, callbacks);
+        },
+    };
+    const document = {
+        getElementById: (id) => (id === "WelinkGameVideo" ? video : layer),
+        elementFromPoint: (x, y) => (hitTest ? hitTest(x, y) : menu),
+        querySelector(selector) {
+            assert.equal(selector, 'button[aria-label="游戏菜单"]');
+            return menu ? {parentElement: menu} : null;
+        },
+    };
+    vm.runInNewContext(script, {
+        window,
+        document,
+        HTMLCanvasElement: class {},
+        Element: class {},
+        URL,
+        location: {href: "https://endfield.hypergryph.com/cloud"},
+    });
+    return {
+        prepare: window.__maaCloudMouseMove,
+        input: (active, x = 30, y = 80) => window.__maaCloudMouseInput(active, x, y),
+        replaceMenu: (replacement) => {
+            menu = replacement;
+        },
+        resource(type, source) {
+            const event = {target: {src: source}};
+            for (const listener of listeners.get(type) ?? []) listener(event);
+        },
+        errors: () => window.__maaCloudStartupErrors,
+        move(x, y, dx, dy, trusted = true, buttons = 0) {
+            const event = {clientX: x, clientY: y, movementX: dx, movementY: dy, isTrusted: trusted, buttons};
+            for (const listener of listeners.get("mousemove") ?? []) listener(event);
+            return [
+                event.movementX,
+                event.movementY,
+            ];
+        },
+    };
+}
+
+test("a successful resource retry removes its stale startup error without hiding unrelated failures", () => {
+    const page = browser();
+    const sdk = "https://web.hycdn.cn/hg_web_sdk/lib/sdk.entry.js";
+    const react = "https://web.hycdn.cn/static/js/umd/react/react@18.3.1.js";
+    page.resource("error", sdk + "?first=1#fragment");
+    page.resource("error", react);
+    assert.equal(page.errors().length, 2);
+    assert.equal(page.errors()[0].source, sdk);
+    page.resource("load", sdk + "?retry=2");
+    assert.equal(page.errors().length, 1);
+    assert.equal(page.errors()[0].source, react);
+    page.resource("load", sdk);
+    assert.equal(page.errors().length, 1);
+});
+
+test("automation excludes the official game menu only during its mouse transaction", () => {
+    const menu = {
+        inert: false,
+        contains(element) {
+            return element === this;
+        },
+    };
+    const page = browser({video: {readyState: 2, paused: false, ended: false}, menu});
+    assert.equal(page.input(true), true);
+    assert.equal(menu.inert, true);
+    assert.equal(page.input(false), true);
+    assert.equal(menu.inert, false);
+    // Cleanup is idempotent and another transaction restores its own state.
+    page.input(false);
+    menu.inert = true;
+    page.input(true);
+    page.input(false);
+    assert.equal(menu.inert, true);
+});
+
+test("landing, paused and ended pages keep their website controls", () => {
+    for (const video of [
+        null,
+        {readyState: 1, paused: false},
+        {readyState: 2, paused: true},
+        {readyState: 2, paused: false, ended: true},
+    ]) {
+        const menu = {
+            inert: false,
+            contains(element) {
+                return element === this;
+            },
+        };
+        const page = browser({video, menu});
+        page.input(true);
+        assert.equal(menu.inert, false);
+        page.input(false);
+    }
+});
+
+test("an absent menu and an ancestor of the game surface are not disabled", () => {
+    const video = {readyState: 2, paused: false};
+    const menu = {inert: false, contains: (element) => element === video};
+    const page = browser({video, menu});
+    page.input(true);
+    assert.equal(menu.inert, false);
+    page.input(false);
+    const absent = browser({video});
+    assert.equal(absent.input(true), false);
+    assert.equal(absent.input(false), true);
+});
+
+test("replaced menu nodes and interrupted transactions restore the previous menu", () => {
+    const menu = {
+        inert: false,
+        contains(element) {
+            return element === this;
+        },
+    };
+    const page = browser({video: {readyState: 2, paused: false}, menu});
+    page.input(true);
+    page.input(true);
+    const replacement = {
+        inert: false,
+        contains(element) {
+            return element === this;
+        },
+    };
+    page.replaceMenu(replacement);
+    page.input(true);
+    assert.equal(menu.inert, false);
+    assert.equal(replacement.inert, true);
+    page.input(false);
+    assert.equal(menu.inert, false);
+    assert.equal(replacement.inert, false);
+});
+
+test("unobstructed game input does not change menu hit testing", () => {
+    const menu = {
+        inert: false,
+        contains(element) {
+            return element === this;
+        },
+    };
+    let changes = 0;
+    Object.defineProperty(menu, "inert", {
+        get: () => false,
+        set: () => {
+            changes++;
+        },
+    });
+    const page = browser({video: {readyState: 2, paused: false}, menu, hitTest: () => null});
+    assert.equal(page.input(true, 640, 360), false);
+    assert.equal(changes, 0);
+});
+
+test("absolute automation moves do not become camera deltas", () => {
+    const page = browser();
+    for (const x of [
+        640,
+        740,
+        840,
+        640,
+    ]) {
+        assert.equal(page.prepare(x, 360, 0, 0), true);
+        assert.deepEqual(
+            page.move(x, 360, 100, -10),
+            [
+                0,
+                0,
+            ],
+        );
+    }
+    assert.deepEqual(
+        page.move(650, 360, 10, 5),
+        [
+            10,
+            5,
+        ],
+    );
+});
+
+test("relative camera movement is delivered once at its anchor", () => {
+    const page = browser();
+    page.prepare(640, 360, 127, -42);
+    assert.deepEqual(
+        page.move(640, 360, 0, 0),
+        [
+            127,
+            -42,
+        ],
+    );
+    assert.deepEqual(
+        page.move(640, 360, 4, 3),
+        [
+            4,
+            3,
+        ],
+    );
+});
+
+test("absolute dragging retains motion while relative dragging uses its requested delta", () => {
+    const page = browser();
+    page.prepare(740, 360, 0, 0);
+    assert.deepEqual(
+        page.move(740, 360, 100, 5, true, 1),
+        [
+            100,
+            5,
+        ],
+    );
+    page.prepare(640, 360, 40, -10);
+    assert.deepEqual(
+        page.move(640, 360, -100, 0, true, 1),
+        [
+            40,
+            -10,
+        ],
+    );
+    page.prepare(740, 360, 0, 0);
+    assert.deepEqual(
+        page.move(740, 360, 100, 5),
+        [
+            0,
+            0,
+        ],
+    );
+});
+
+test("unrelated and synthetic events cannot consume prepared movement", () => {
+    const page = browser();
+    page.prepare(640, 360, 80, 0);
+    assert.deepEqual(
+        page.move(641, 360, 1, 0),
+        [
+            1,
+            0,
+        ],
+    );
+    assert.deepEqual(
+        page.move(640, 361, 0, 1),
+        [
+            0,
+            1,
+        ],
+    );
+    assert.deepEqual(
+        page.move(640, 360, 2, 3, false),
+        [
+            2,
+            3,
+        ],
+    );
+    assert.deepEqual(
+        page.move(640, 360, 0, 0),
+        [
+            80,
+            0,
+        ],
+    );
+});
+
+test("cancelled dispatch leaves subsequent user movement intact", () => {
+    const page = browser();
+    page.prepare(640, 360, 80, 0);
+    page.prepare(null, null, null, null);
+    assert.deepEqual(
+        page.move(640, 360, 7, -6),
+        [
+            7,
+            -6,
+        ],
+    );
+});
diff --git a/agent/cpp-algo/cloud-webview/tests/page_state.test.mjs b/agent/cpp-algo/cloud-webview/tests/page_state.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..441aa51a61aafeb86d9efffe218ad4b1d172353e
--- /dev/null
+++ b/agent/cpp-algo/cloud-webview/tests/page_state.test.mjs
@@ -0,0 +1,372 @@
+import assert from "node:assert/strict";
+import {readFileSync} from "node:fs";
+import test from "node:test";
+import vm from "node:vm";
+
+const source = readFileSync(new URL("../CloudBridge.cpp", import.meta.url), "utf8");
+const script = source.match(/constexpr char kPageState\[\] = R"JS\(([\s\S]*?)\)JS";/)?.[1];
+assert.ok(script);
+
+function inspect({
+    text = "",
+    video = true,
+    canvas = false,
+    button = false,
+    decorated = false,
+    blocked = false,
+    signedIn = false,
+    width = 1280,
+    busyDialog = false,
+    busyHidden = false,
+    busyBlocked = false,
+    busyDisabled = false,
+    unrelatedConfirm = false,
+    endedDialog = false,
+    queueTimeoutDialog = false,
+    noticeHidden = false,
+    noticeBlocked = false,
+    noticeDisabled = false,
+    noticeAriaDisabled = false,
+    noticeAmbiguous = false,
+    noticeConfirmOutside = false,
+    noticeSemantic = false,
+    noticeSplitText = false,
+    sdkFailed = false,
+    resourceErrors = [],
+    documentReady = "complete",
+} = {}) {
+    const element = (label) => ({
+        textContent: label,
+        children: [],
+        getClientRects: () => [{}],
+        closest: () => null,
+        getBoundingClientRect: () => ({x: 1044, y: 570, width: 121, height: 48}),
+        contains: () => false,
+    });
+    const start = button ? element("开始游戏") : null;
+    if (start && decorated) start.children = [element("")];
+    const message = busyDialog ? element("您上次游戏的数据正在火速处理中，请稍后再试") : null;
+    const attachNotice = (message, confirm, rect) => {
+        if (!message) return;
+        const parent = {
+            textContent: message.textContent + (noticeConfirmOutside ? "" : "知道了"),
+            querySelectorAll: () =>
+                noticeConfirmOutside
+                    ? [message]
+                    : noticeAmbiguous
+                      ? [
+                            message,
+                            confirm,
+                            element("知道了"),
+                        ]
+                      : [
+                            message,
+                            confirm,
+                        ],
+        };
+        message.parentElement = parent;
+        message.getClientRects = () => (noticeHidden ? [] : [{}]);
+        if (noticeSplitText)
+            message.children = [
+                element(message.textContent.slice(0, 5)),
+                element(message.textContent.slice(5)),
+            ];
+        const closest = (selector) =>
+            selector.includes("aria-disabled") ? (noticeAriaDisabled ? parent : null) : noticeSemantic ? parent : null;
+        message.closest = closest;
+        confirm.closest = closest;
+        confirm.disabled = noticeDisabled;
+        confirm.getBoundingClientRect = () => rect;
+        if (noticeConfirmOutside) {
+            parent.parentElement = {
+                textContent: message.textContent + "其他提示知道了开始游戏",
+                querySelectorAll: () => [
+                    message,
+                    confirm,
+                ],
+            };
+        }
+    };
+    const endedMessage = endedDialog ? element("由于您长时间未操作，本次游戏已自动结束") : null;
+    const endedConfirm = endedDialog ? element("知道了") : null;
+    attachNotice(endedMessage, endedConfirm, {x: 600, y: 180, width: 100, height: 40});
+    const queueTimeoutMessage = queueTimeoutDialog ? element("排队超时，请保证排队过程网络畅通") : null;
+    const queueTimeoutConfirm = queueTimeoutDialog ? element("知道了") : null;
+    attachNotice(queueTimeoutMessage, queueTimeoutConfirm, {x: 700, y: 400, width: 100, height: 40});
+    const confirm = busyDialog ? element("知道了") : null;
+    if (confirm) {
+        confirm.disabled = busyDisabled;
+        confirm.getBoundingClientRect = () => ({x: 500, y: 400, width: 100, height: 40});
+        message.getClientRects = () => (busyHidden ? [] : [{}]);
+        message.parentElement = {
+            textContent: message.textContent + confirm.textContent,
+            querySelectorAll: () => [
+                message,
+                confirm,
+            ],
+        };
+    }
+    const elements = [
+        start,
+        signedIn ? element("退出登录") : null,
+        message,
+        confirm,
+        endedMessage,
+        endedConfirm,
+        queueTimeoutMessage,
+        queueTimeoutConfirm,
+        unrelatedConfirm ? element("知道了") : null,
+    ].filter(Boolean);
+    const movie = {
+        readyState: 4,
+        paused: false,
+        ended: false,
+        videoWidth: width,
+        videoHeight: 720,
+        getClientRects: () => [{}],
+    };
+    return vm.runInNewContext(script, {
+        window: {
+            __maaCloudStartupErrors: sdkFailed
+                ? [{type: "resource", source: "https://web.hycdn.cn/hg_web_sdk/lib/sdk.entry.js"}]
+                : resourceErrors.map((source) => ({type: "resource", source})),
+        },
+        performance: {timeOrigin: 1},
+        document: {
+            readyState: documentReady,
+            body: {innerText: text},
+            getElementById: () => (canvas ? {tagName: "CANVAS"} : video ? {tagName: "VIDEO"} : null),
+            querySelectorAll: (selector) =>
+                selector === "video" ? (video ? [movie] : []) : selector === "input" ? [] : elements,
+            elementFromPoint: (x) =>
+                x === 550
+                    ? busyBlocked
+                        ? element("遮罩")
+                        : confirm
+                    : x === 650
+                      ? noticeBlocked
+                          ? element("遮罩")
+                          : endedConfirm
+                      : x === 750
+                        ? noticeBlocked
+                            ? element("遮罩")
+                            : queueTimeoutConfirm
+                        : blocked
+                          ? element("遮罩")
+                          : start,
+        },
+        getComputedStyle: () => ({visibility: "visible"}),
+        screen: {width: 1280, height: 720},
+        devicePixelRatio: 1,
+        innerWidth: 1280,
+        innerHeight: 720,
+    });
+}
+
+test("explicit startup and queue states override a stale video", () => {
+    for (const [
+        text,
+        expected,
+    ] of [
+        [
+            "游戏启动中，请耐心等待",
+            "starting",
+        ],
+        [
+            "游戏启动中，\n请耐心等待",
+            "starting",
+        ],
+        [
+            "正在排队，前方还有 12 人",
+            "queue",
+        ],
+        [
+            "由于您长时间未操作，\n本次游戏已自动结束",
+            "ended",
+        ],
+    ]) {
+        const state = inspect({text});
+        assert.equal(state.page, expected);
+        assert.equal(state.video_ready, false);
+    }
+});
+
+test("a visible previous-session notice blocks stale video and exposes its own confirmation", () => {
+    const state = inspect({busyDialog: true});
+    assert.equal(state.page, "session_busy");
+    assert.equal(state.video_ready, false);
+    assert.equal(state.session_busy_confirm_target.x, 550);
+    assert.equal(state.session_busy_confirm_target.y, 420);
+});
+
+test("an inactivity-ended session exposes only its own confirmation", () => {
+    const state = inspect({endedDialog: true, text: "由于您长时间未操作，本次游戏已自动结束"});
+    assert.equal(state.page, "ended");
+    assert.equal(state.video_ready, false);
+    assert.equal(state.ended_confirm_target.x, 650);
+    assert.equal(state.ended_confirm_target.y, 200);
+    assert.equal(inspect({text: "其他提示：知道了"}).ended_confirm_target, null);
+});
+
+test("a queue timeout is distinguished from an active queue and exposes its own confirmation", () => {
+    const state = inspect({queueTimeoutDialog: true, text: "排队超时，请保证排队过程网络畅通"});
+    assert.equal(state.page, "queue_timeout");
+    assert.equal(state.video_ready, false);
+    assert.equal(state.queue_timeout_confirm_target.x, 750);
+    assert.equal(state.queue_timeout_confirm_target.y, 420);
+    assert.equal(inspect({text: "排队中，前方还有 12 人"}).page, "queue");
+    assert.equal(inspect({text: "其他提示：知道了"}).queue_timeout_confirm_target, null);
+});
+
+for (const [
+    option,
+    field,
+] of [
+    [
+        "endedDialog",
+        "ended_confirm_target",
+    ],
+    [
+        "queueTimeoutDialog",
+        "queue_timeout_confirm_target",
+    ],
+]) {
+    test(`${option} rejects blocked, disabled, ambiguous or unrelated confirmations`, () => {
+        for (const options of [
+            {noticeBlocked: true},
+            {noticeDisabled: true},
+            {noticeAriaDisabled: true},
+            {noticeAmbiguous: true},
+            {noticeConfirmOutside: true},
+            {noticeConfirmOutside: true, noticeSemantic: true},
+        ]) {
+            assert.equal(inspect({[option]: true, ...options})[field], null);
+        }
+    });
+    test(`${option} ignores hidden messages and supports split text and dialog roles`, () => {
+        const hidden = inspect({[option]: true, noticeHidden: true});
+        assert.equal(hidden[field], null);
+        assert.equal(hidden.page, "stream");
+        assert.equal(hidden.video_ready, true);
+        for (const options of [
+            {noticeSplitText: true},
+            {noticeSemantic: true},
+        ]) {
+            assert.notEqual(inspect({[option]: true, ...options})[field], null);
+        }
+    });
+}
+
+test("a hidden previous-session notice does not block a decoded stream", () => {
+    const state = inspect({busyDialog: true, busyHidden: true});
+    assert.equal(state.page, "stream");
+    assert.equal(state.video_ready, true);
+    assert.equal(state.session_busy_confirm_target, null);
+});
+
+test("blocked, disabled and unrelated confirmations are never actionable", () => {
+    for (const options of [
+        {busyBlocked: true},
+        {busyDisabled: true},
+    ]) {
+        const state = inspect({busyDialog: true, ...options});
+        assert.equal(state.page, "session_busy");
+        assert.equal(state.session_busy_confirm_target, null);
+    }
+    const state = inspect({unrelatedConfirm: true, text: "其他提示：知道了"});
+    assert.equal(state.session_busy_confirm_target, null);
+});
+
+test("landing is authenticated independently from stream readiness", () => {
+    const state = inspect({video: false, button: true, signedIn: true});
+    assert.equal(state.account, "signed_in");
+    assert.equal(state.page, "landing");
+    assert.equal(state.video_ready, false);
+    assert.equal(state.start_available, true);
+    assert.equal(state.start_target.x, 1104.5);
+    assert.equal(state.start_target.y, 594);
+});
+
+test("an obscured start button cannot be clicked", () => {
+    const state = inspect({video: false, button: true, blocked: true, signedIn: true});
+    assert.equal(state.page, "landing");
+    assert.equal(state.start_available, false);
+    assert.equal(state.start_target, null);
+});
+
+test("the official start label can contain a decorative icon", () => {
+    const state = inspect({video: false, button: true, decorated: true, signedIn: true});
+    assert.equal(state.page, "landing");
+    assert.equal(state.start_available, true);
+});
+
+test("only a decoded video is ready", () => {
+    assert.equal(inspect().video_ready, true);
+    assert.equal(inspect({width: 0}).video_ready, false);
+});
+
+test("an unsupported canvas renderer is diagnosed without authorizing daily startup", () => {
+    const state = inspect({video: false, canvas: true});
+    assert.equal(state.game_surface, "canvas");
+    assert.equal(state.video_ready, false);
+    assert.equal(state.page, "loading");
+    assert.equal(inspect().game_surface, "video");
+    assert.equal(inspect({video: false}).game_surface, "none");
+});
+
+test("login and expired-session pages never authorize daily startup", () => {
+    const state = inspect({text: "手机号登录", video: false});
+    assert.equal(state.page, "login");
+    assert.equal(state.account, "signed_out");
+    assert.equal(state.video_ready, false);
+});
+
+test("failed official bootstrap dependencies are distinguished from unrelated resource errors", () => {
+    for (const source of [
+        "https://web.hycdn.cn/static/js/umd/react/react@18.3.1.js",
+        "https://web.hycdn.cn/static/js/umd/react-dom/react-dom@18.3.1.js",
+        "https://cloud-game-web-static.hycdn.cn/cloud-game/prod/index.cda000.js",
+        "https://cloud-game-web-static.hycdn.cn/cloud-game/prod/commons.80b897.js",
+    ]) {
+        const options = {video: false, resourceErrors: [source]};
+        assert.equal(inspect(options).page, "startup_error");
+        assert.equal(inspect({...options, text: "手机号登录"}).startup_resource_failed, false);
+        assert.equal(inspect({...options, signedIn: true}).startup_resource_failed, false);
+        assert.equal(inspect({...options, video: true}).startup_resource_failed, false);
+    }
+    for (const source of [
+        "https://cloud-game-web-static.hycdn.cn/cloud-game/prod/assets/imgs/logo.146f17.png",
+        "https://other.example/sdk.entry.js",
+        "https://web.hycdn.cn/hg_web_sdk/lib/sdk.entry.js.extra",
+    ]) {
+        assert.equal(inspect({video: false, resourceErrors: [source]}).startup_resource_failed, false);
+    }
+});
+
+test("a failed account SDK is distinct from waiting for user authentication", () => {
+    const failed = inspect({video: false, button: true, sdkFailed: true});
+    assert.equal(failed.page, "startup_error");
+    assert.equal(failed.startup_resource_failed, true);
+    assert.equal(inspect({video: false, text: "手机号登录", sdkFailed: true}).startup_resource_failed, false);
+    assert.equal(inspect({sdkFailed: true}).startup_resource_failed, false);
+    assert.equal(inspect({video: false, button: true, signedIn: true, sdkFailed: true}).startup_resource_failed, false);
+});
+
+test("bootstrap errors cannot reload a document still loading or an accepted game startup", () => {
+    const options = {video: false, button: true, sdkFailed: true};
+    for (const documentReady of [
+        "loading",
+        "interactive",
+    ]) {
+        assert.equal(inspect({...options, documentReady}).startup_resource_failed, false);
+    }
+    for (const text of [
+        "正在排队，前方还有 12 人",
+        "游戏启动中，请耐心等待",
+    ]) {
+        const state = inspect({...options, text});
+        assert.equal(state.startup_resource_failed, false);
+        assert.notEqual(state.page, "startup_error");
+    }
+    assert.equal(inspect(options).startup_resource_failed, true);
+});
diff --git a/agent/cpp-algo/cloud-webview/tests/startup_notice_policy_test.cpp b/agent/cpp-algo/cloud-webview/tests/startup_notice_policy_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3f9a4fdb356d2acf1a1a4c38499082d8826f1249
--- /dev/null
+++ b/agent/cpp-algo/cloud-webview/tests/startup_notice_policy_test.cpp
@@ -0,0 +1,89 @@
+#include <chrono>
+#include <iostream>
+
+#include "startup_notice_policy.h"
+
+int main()
+{
+    using Policy = cloud::StartupNoticePolicy;
+    using Action = Policy::Action;
+    using namespace std::chrono_literals;
+
+    const auto now = Policy::Clock::time_point {};
+    int failures = 0;
+    int checks = 0;
+    const auto expect = [&](Action actual, Action expected, const char* scenario) {
+        ++checks;
+        if (actual != expected) {
+            std::cerr << "FAIL: " << scenario << '\n';
+            ++failures;
+        }
+    };
+
+    Policy stuck;
+    expect(stuck.observe(false, now), Action::None, "normal page does not acknowledge a notice");
+    expect(stuck.observe(true, now), Action::Confirm, "first notice is acknowledged once");
+    expect(stuck.observe(true, now + 9999ms), Action::Wait, "wait for dismissal without clicking again");
+    expect(stuck.observe(true, now + 10s), Action::Fail, "unclosed notice fails at deadline");
+    expect(stuck.observe(true, now + 1h), Action::Fail, "waiting cannot extend the deadline");
+
+    Policy repeated;
+    expect(repeated.observe(true, now), Action::Confirm, "first queue timeout can recover");
+    expect(repeated.observe(false, now + 500ms), Action::None, "landing page clears pending acknowledgement");
+    expect(repeated.observe(false, now + 20min), Action::None, "normal queue is not timed out by notice policy");
+    expect(repeated.observe(true, now + 21min), Action::Fail, "second queue timeout fails even after dismissal");
+
+    Policy ended;
+    expect(ended.observe(true, now), Action::Confirm, "ended notice has its own recovery allowance");
+    expect(ended.observe(false, now + 1s), Action::None, "ended notice can return to landing");
+    expect(ended.observe(true, now + 2s), Action::Fail, "repeated ended notice does not loop");
+
+    Policy another_run;
+    expect(another_run.observe(true, now), Action::Confirm, "a new preparation attempt has a fresh allowance");
+
+    Policy delayed_button;
+    expect(delayed_button.observe(true, now, false), Action::Wait, "notice waits for its button to become actionable");
+    expect(delayed_button.observe(true, now + 2s, false), Action::Wait, "waiting for hydration does not consume confirmation");
+    expect(delayed_button.observe(true, now + 3s, true), Action::Confirm, "hydrated button is confirmed once");
+    expect(delayed_button.observe(true, now + 4s, true), Action::Wait, "confirmed button is never clicked twice");
+    expect(delayed_button.observe(false, now + 5s), Action::None, "dismissed hydrated notice returns to landing");
+    expect(delayed_button.observe(true, now + 6s, true), Action::Fail, "reappearing notice cannot replenish confirmation");
+
+    Policy missing_button;
+    expect(missing_button.observe(true, now, false), Action::Wait, "missing confirmation starts a bounded readiness wait");
+    expect(missing_button.observe(true, now + 9999ms, false), Action::Wait, "polling cannot reset button readiness deadline");
+    expect(missing_button.observe(true, now + 10s, false), Action::Fail, "permanently missing button fails at deadline");
+    expect(missing_button.observe(true, now + 11s, true), Action::Fail, "late hydration cannot revive an expired notice");
+
+    using ResourcePolicy = cloud::StartupResourcePolicy;
+    using ResourceAction = ResourcePolicy::Action;
+    const auto expect_resource = [&](ResourceAction actual, ResourceAction expected, const char* scenario) {
+        ++checks;
+        if (actual != expected) {
+            std::cerr << "FAIL: " << scenario << '\n';
+            ++failures;
+        }
+    };
+    ResourcePolicy resource;
+    expect_resource(resource.recover(), ResourceAction::Reload, "first explicit dependency failure permits a normal reload");
+    ++checks;
+    if (resource.retry_delay() != 1s) {
+        std::cerr << "FAIL: first bootstrap recovery has bounded network backoff\n";
+        ++failures;
+    }
+    expect_resource(resource.recover(), ResourceAction::ReloadIgnoringCache, "repeated dependency failure bypasses cached response");
+    ++checks;
+    if (resource.retry_delay() != 2s) {
+        std::cerr << "FAIL: uncached bootstrap recovery backs off without changing normal input\n";
+        ++failures;
+    }
+    expect_resource(resource.recover(), ResourceAction::Fail, "uncached failure does not cause an unbounded reload loop");
+    expect_resource(resource.recover(), ResourceAction::Fail, "exhausted bootstrap budget remains exhausted");
+    ResourcePolicy new_preparation;
+    expect_resource(new_preparation.recover(), ResourceAction::Reload, "a separate preparation has its own reload budget");
+    if (failures) {
+        return 1;
+    }
+    std::cout << "Startup policies: " << checks << " checks passed.\n";
+    return 0;
+}
diff --git a/agent/cpp-algo/cloud-webview/tests/stream_policy.test.mjs b/agent/cpp-algo/cloud-webview/tests/stream_policy.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..eb4faec0081841d45f26ca2f4963dd9490d378cd
--- /dev/null
+++ b/agent/cpp-algo/cloud-webview/tests/stream_policy.test.mjs
@@ -0,0 +1,47 @@
+import assert from "node:assert/strict";
+import {readFileSync} from "node:fs";
+import test from "node:test";
+import vm from "node:vm";
+
+const source = readFileSync(new URL("../input_policy.h", import.meta.url), "utf8");
+const script = source.match(/LR"JS\(([\s\S]*?)\)JS";/)?.[1];
+assert.ok(script);
+
+for (const gpu of [
+    false,
+    true,
+]) {
+    test(`default enhancement cannot replace video with a canvas (GPU=${gpu})`, () => {
+        class WebGL2RenderingContext {}
+        const pixels = {};
+        const webgl = {};
+        const calls = [];
+        class HTMLCanvasElement {
+            getContext(type, options) {
+                calls.push({target: this, type, options});
+                if (type === "webgl2") return gpu ? new WebGL2RenderingContext() : null;
+                return type === "2d" ? pixels : webgl;
+            }
+        }
+        // The SDK checks WebGL2 for enhancement on both WebRTC and WebTransport.
+        const enhanced = () => new HTMLCanvasElement().getContext("webgl2") instanceof WebGL2RenderingContext;
+        assert.equal(enhanced(), gpu);
+        const browser = {
+            WebTransport: class {},
+            VideoDecoder: class {},
+            RTCPeerConnection: class {},
+            addEventListener() {},
+        };
+        const capabilities = {...browser};
+        vm.runInNewContext(script, {window: browser, HTMLCanvasElement, Element: class {}});
+        assert.equal(enhanced(), false);
+        assert.equal(browser.VideoDecoder, capabilities.VideoDecoder);
+        assert.equal(browser.WebTransport, capabilities.WebTransport);
+        assert.equal(browser.RTCPeerConnection, capabilities.RTCPeerConnection);
+        const canvas = new HTMLCanvasElement();
+        const options = {alpha: false, willReadFrequently: true};
+        assert.equal(canvas.getContext("2d", options), pixels);
+        assert.deepEqual(calls.at(-1), {target: canvas, type: "2d", options});
+        assert.equal(canvas.getContext("webgl"), webgl);
+    });
+}
diff --git a/agent/cpp-algo/cloud-webview/tests/win32_bridge_test.cpp b/agent/cpp-algo/cloud-webview/tests/win32_bridge_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..97cf3ad0b01df35db8eeccba2fb86f8191a06c6c
--- /dev/null
+++ b/agent/cpp-algo/cloud-webview/tests/win32_bridge_test.cpp
@@ -0,0 +1,260 @@
+#include <atomic>
+#include <chrono>
+#include <iostream>
+#include <stdexcept>
+#include <string_view>
+#include <tuple>
+#include <vector>
+
+#include <MaaFramework/MaaAPI.h>
+#include <MaaToolkit/MaaToolkitAPI.h>
+
+#include "Common/CloudViewInput.h"
+#include "Win32ControllerBridge.h"
+#include "transport/win_cloud_transport.h"
+#include "win32_bridge_protocol.h"
+
+namespace
+{
+void Check(bool condition, const char* message)
+{
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+class RecordingTransport final : public CloudTransport
+{
+public:
+    bool connect() override { return true; }
+
+    bool capture(CloudFrame& output) override
+    {
+        const auto sequence = ++captures;
+        output.width = 1280;
+        output.height = 720;
+        if (output.pixels.capacity() < 1280 * 720 * 3) {
+            ++frame_allocations;
+        }
+        output.pixels.resize(1280 * 720 * 3);
+        for (size_t i = 0; i < output.pixels.size(); i += 3) {
+            output.pixels[i] = static_cast<uint8_t>((sequence % 254) + 1);
+            output.pixels[i + 1] = 83;
+            output.pixels[i + 2] = 231;
+        }
+        return true;
+    }
+
+    bool mouse(const CloudMouseEvent& event) override
+    {
+        mouse_events.push_back(event);
+        return true;
+    }
+
+    bool key(int32_t key, bool down, int32_t, bool) override
+    {
+        keys.emplace_back(key, down);
+        return true;
+    }
+
+    bool insert_text(const std::string& text) override
+    {
+        inserted += text;
+        return true;
+    }
+
+    bool relative_move(int32_t dx, int32_t dy, int32_t, int32_t) override
+    {
+        moves.emplace_back(dx, dy);
+        return true;
+    }
+
+    std::vector<CloudMouseEvent> mouse_events;
+    std::vector<std::pair<int32_t, bool>> keys;
+    std::vector<std::pair<int32_t, int32_t>> moves;
+    std::string inserted;
+    std::atomic<int> captures = 0;
+    std::atomic<int> frame_allocations = 0;
+};
+} // namespace
+
+int main(int argc, char** argv)
+{
+    if (argc == 2 && std::string_view(argv[1]) == "--bridge-owner") {
+        Sleep(500);
+        return 0;
+    }
+    try {
+        SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+        std::vector<std::string> local_operations;
+        bool accepted = true;
+        // PID zero makes an accidental pipe fallback fail. In-process input
+        // must reach the callback once, including failed dispatches.
+        WinCloudTransport local(0, [&](const json::value& request) {
+            local_operations.push_back(request.at("op").as_string());
+            return json::value(json::object { { "ok", accepted } });
+        });
+        Check(local.mouse({ CloudMouseAction::Move, 640, 360 }), "local mouse dispatch failed");
+        Check(local.key(27, false, 0, false), "local key dispatch failed");
+        Check(local.insert_text("A测试"), "local text dispatch failed");
+        Check(local.relative_move(-70000, 80000, 0, 0), "local relative dispatch failed");
+        accepted = false;
+        Check(!local.key(27, false, 0, false), "failed local input was accepted");
+        Check(
+            local_operations == std::vector<std::string> { "mouse", "key", "text", "relative", "key" },
+            "local input was lost or replayed");
+        RecordingTransport transport;
+        Win32ControllerBridge bridge(transport);
+        HWND hwnd = nullptr;
+        EnumWindows(
+            [](HWND candidate, LPARAM result) -> BOOL {
+                DWORD pid = 0;
+                GetWindowThreadProcessId(candidate, &pid);
+                wchar_t name[128] {};
+                if (pid == GetCurrentProcessId() && GetClassNameW(candidate, name, static_cast<int>(std::size(name)))
+                    && std::wstring_view(name) == cloud::win32bridge::kClass) {
+                    *reinterpret_cast<HWND*>(result) = candidate;
+                    return FALSE;
+                }
+                return TRUE;
+            },
+            reinterpret_cast<LPARAM>(&hwnd));
+        Check(hwnd != nullptr, "bridge window absent");
+        auto windows = MaaToolkitDesktopWindowListCreate();
+        Check(MaaToolkitDesktopWindowFindAll(windows), "Toolkit enumeration failed");
+        bool found = false;
+        for (MaaSize i = 0; i < MaaToolkitDesktopWindowListSize(windows); ++i) {
+            found |= MaaToolkitDesktopWindowGetHandle(MaaToolkitDesktopWindowListAt(windows, i)) == hwnd;
+        }
+        MaaToolkitDesktopWindowListDestroy(windows);
+        Check(found, "unmodified Toolkit cannot enumerate bridge");
+
+        const auto foreground = GetForegroundWindow();
+        POINT before {};
+        GetCursorPos(&before);
+        auto ctrl = MaaWin32ControllerCreate(
+            hwnd,
+            MaaWin32ScreencapMethod_PrintWindow,
+            MaaWin32InputMethod_SendMessage,
+            MaaWin32InputMethod_SendMessage);
+        Check(ctrl != nullptr, "Win32 controller creation failed");
+        const auto wait = [&](MaaCtrlId id) {
+            Check(MaaControllerWait(ctrl, id) == MaaStatus_Succeeded, "controller action failed");
+        };
+        wait(MaaControllerPostConnection(ctrl));
+        Check(SendMessageW(hwnd, cloud::win32bridge::kPrepareFrame, 0, 0) == 1, "frame preparation failed");
+        auto tasker = MaaTaskerCreate();
+        Check(MaaTaskerBindController(tasker, ctrl), "bind tasker controller failed");
+        cloud::TaskerEvent(tasker, "Tasker.Task.Starting", R"({"task_id":1})", nullptr);
+        auto image = MaaImageBufferCreate();
+        const auto started = std::chrono::steady_clock::now();
+        uint8_t previous = 0;
+        int changes = 0;
+        for (int i = 0; i < 50; ++i) {
+            wait(MaaControllerPostScreencap(ctrl));
+            Check(MaaControllerCachedImage(ctrl, image), "cached image unavailable");
+            Check(MaaImageBufferWidth(image) == 1280 && MaaImageBufferHeight(image) == 720, "frame size changed");
+            int32_t controller_width = 0;
+            int32_t controller_height = 0;
+            Check(
+                MaaControllerGetResolution(ctrl, &controller_width, &controller_height) && controller_width == 1280
+                    && controller_height == 720,
+                "controller resolution left the fixed cloud input space");
+            const auto pixels = static_cast<const uint8_t*>(MaaImageBufferGetRawData(image));
+            if (pixels && (pixels[0] == 0 || pixels[1] != 83 || pixels[2] != 231)) {
+                std::cerr << "Got BGR " << int(pixels[0]) << ',' << int(pixels[1]) << ',' << int(pixels[2]) << "; capture callbacks "
+                          << transport.captures.load() << '\n';
+            }
+            Check(pixels && pixels[0] != 0 && pixels[1] == 83 && pixels[2] == 231, "BGR frame mismatch");
+            changes += pixels[0] != previous;
+            previous = pixels[0];
+        }
+        Check(changes >= 30, "PrintWindow surface stopped updating");
+        Check(transport.frame_allocations.load() == 2, "frame buffers were not reused");
+        std::cout << "50 PrintWindow captures: "
+                  << std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started).count() << " ms\n";
+        std::cout << "Total frame callbacks: " << transport.captures.load() << '\n';
+        std::cout << "Frame allocations: " << transport.frame_allocations.load() << '\n';
+        wait(MaaControllerPostClick(ctrl, 1001, 613));
+        Check(transport.mouse_events.size() >= 3, "mouse input missing");
+        const auto& press = transport.mouse_events[transport.mouse_events.size() - 2];
+        Check(
+            press.action == CloudMouseAction::Press && press.x == 1001 && press.y == 613 && press.buttons == 1,
+            "click coordinate or button mismatch");
+        wait(MaaControllerPostSwipe(ctrl, 1025, 575, 1180, 575, 200));
+        const auto& release = transport.mouse_events.back();
+        Check(
+            release.action == CloudMouseAction::Release && release.x == 1180 && release.y == 575 && release.buttons == 0,
+            "Win32 swipe released at its starting position");
+        wait(MaaControllerPostKeyDown(ctrl, 27));
+        wait(MaaControllerPostKeyUp(ctrl, 27));
+        Check(transport.keys == std::vector<std::pair<int32_t, bool>> { { 27, true }, { 27, false } }, "Esc mismatch");
+        wait(MaaControllerPostInputText(ctrl, "A测试"));
+        Check(transport.inserted == "A测试", "text mismatch");
+        const auto relative = cloud::CreateViewInput(ctrl);
+        Check(static_cast<bool>(relative), "cloud relative extension not detected");
+        Check(relative(-70000, 80000), "relative input failed");
+        Check(transport.moves == std::vector<std::pair<int32_t, int32_t>> { { -70000, 80000 } }, "relative delta truncated");
+        wait(MaaControllerPostKeyDown(ctrl, 87));
+        cloud::TaskerEvent(tasker, "Tasker.Task.Failed", R"({"task_id":1})", nullptr);
+        Check(transport.keys.back() == std::pair<int32_t, bool> { 87, false }, "cancel left key held");
+        // Allow the single in-flight capture to settle, then idle must do no work.
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        const auto idle_captures = transport.captures.load();
+        std::this_thread::sleep_for(std::chrono::milliseconds(150));
+        Check(transport.captures.load() == idle_captures, "idle bridge still captures");
+        cloud::TaskerEvent(tasker, "Tasker.Task.Starting", R"({"task_id":2})", nullptr);
+        std::this_thread::sleep_for(std::chrono::milliseconds(120));
+        Check(transport.captures.load() > idle_captures, "restart did not resume captures");
+        // Reentrant AgentServer RPC can deliver an older end after the next
+        // start. It must neither stop captures nor release the new task's hold.
+        wait(MaaControllerPostKeyDown(ctrl, 87));
+        const auto held_keys = transport.keys.size();
+        cloud::TaskerEvent(tasker, "Tasker.Task.Succeeded", R"({"task_id":1})", nullptr);
+        const auto before_delayed_end = transport.captures.load();
+        std::this_thread::sleep_for(std::chrono::milliseconds(150));
+        Check(transport.captures.load() > before_delayed_end, "older task end paused a newer task");
+        Check(transport.keys.size() == held_keys, "older task end released a newer task's key");
+        cloud::TaskerEvent(tasker, "Tasker.Task.Succeeded", R"({"task_id":2})", nullptr);
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        const auto completed_captures = transport.captures.load();
+        cloud::TaskerEvent(tasker, "Tasker.Task.Starting", R"({"task_id":2})", nullptr);
+        cloud::TaskerEvent(tasker, "Tasker.Task.Starting", R"({"task_id":1})", nullptr);
+        std::this_thread::sleep_for(std::chrono::milliseconds(150));
+        Check(transport.captures.load() == completed_captures, "delayed start resumed a completed task");
+        wchar_t executable[32768] {};
+        Check(GetModuleFileNameW(nullptr, executable, static_cast<DWORD>(std::size(executable))), "test executable unavailable");
+        std::wstring command = L"\"" + std::wstring(executable) + L"\" --bridge-owner";
+        STARTUPINFOW startup { sizeof(startup) };
+        PROCESS_INFORMATION process {};
+        Check(
+            CreateProcessW(executable, command.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW, nullptr, nullptr, &startup, &process),
+            "could not create task owner");
+        const auto watched = SendMessageW(hwnd, cloud::win32bridge::kBeginTask, process.dwProcessId, 3);
+        const auto exited = WaitForSingleObject(process.hProcess, 5000);
+        CloseHandle(process.hThread);
+        CloseHandle(process.hProcess);
+        Check(watched == 1 && exited == WAIT_OBJECT_0, "could not watch task owner");
+        wait(MaaControllerPostKeyDown(ctrl, 87));
+        std::this_thread::sleep_for(std::chrono::milliseconds(1200));
+        // A synchronous message establishes a barrier after the timer callback.
+        Check(SendMessageW(hwnd, WM_NULL, 0, 0) == 0, "bridge stopped responding");
+        Check(transport.keys.back() == std::pair<int32_t, bool> { 87, false }, "agent exit left key held");
+        const auto exited_captures = transport.captures.load();
+        std::this_thread::sleep_for(std::chrono::milliseconds(150));
+        Check(transport.captures.load() == exited_captures, "agent exit left frame capture running");
+        POINT after {};
+        GetCursorPos(&after);
+        Check(before.x == after.x && before.y == after.y, "bridge moved system cursor");
+        Check(GetForegroundWindow() == foreground, "bridge stole foreground");
+        MaaImageBufferDestroy(image);
+        MaaTaskerDestroy(tasker);
+        MaaControllerDestroy(ctrl);
+        std::cout << "Unmodified Toolkit + Framework bridge integration passed.\n";
+    }
+    catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+    return 0;
+}
diff --git a/agent/cpp-algo/cloud-webview/transport/CloudInput.h b/agent/cpp-algo/cloud-webview/transport/CloudInput.h
new file mode 100644
index 0000000000000000000000000000000000000000..a312d8491a9a48329302562a44eef67a99d7e9ec
--- /dev/null
+++ b/agent/cpp-algo/cloud-webview/transport/CloudInput.h
@@ -0,0 +1,167 @@
+#pragma once
+
+#include <iostream>
+#include <map>
+#include <mutex>
+#include <set>
+#include <utility>
+
+#include "cloud_transport.h"
+
+// MaaFramework's PC contact values are 0/1/2 (left/right/middle), and -1
+// denotes hover. State belongs to this controller, never to desktop focus.
+class CloudInput
+{
+public:
+    explicit CloudInput(CloudTransport& transport)
+        : transport_(transport)
+    {
+    }
+
+    ~CloudInput()
+    {
+        try {
+            if (!releaseAll()) {
+                std::cerr << "Could not release all cloud controller input during cleanup.\n";
+            }
+        }
+        catch (...) {
+            std::cerr << "Cloud controller input cleanup failed.\n";
+        }
+    }
+
+    bool touchDown(int32_t contact, int32_t x, int32_t y)
+    {
+        std::lock_guard lock(mutex_);
+        if (contact == -1) {
+            return true;
+        }
+        if (!valid_contact(contact)) {
+            return false;
+        }
+        // Retain attempted presses until a release succeeds: a transport
+        // failure can mean the browser applied an event but lost its reply.
+        for (auto& [held_contact, position] : contacts_) {
+            position = { x, y };
+        }
+        contacts_[contact] = { x, y };
+        return transport_.mouse({ CloudMouseAction::Press, x, y, buttons(), 0, 0, contact, modifiers() });
+    }
+
+    bool touchMove(int32_t contact, int32_t x, int32_t y)
+    {
+        std::lock_guard lock(mutex_);
+        if (contact != -1 && !valid_contact(contact)) {
+            return false;
+        }
+        // Win32 mouse moves use contact -1 even while dragging. All buttons
+        // share one pointer; releases must use its latest position, not the
+        // coordinates at which each button was pressed.
+        for (auto& [held_contact, position] : contacts_) {
+            position = { x, y };
+        }
+        return transport_.mouse({ CloudMouseAction::Move, x, y, buttons(), 0, 0, -1, modifiers() });
+    }
+
+    bool touchUp(int32_t contact)
+    {
+        std::lock_guard lock(mutex_);
+        if (contact == -1) {
+            return true;
+        }
+        if (!valid_contact(contact)) {
+            return false;
+        }
+        return release_contact(contact);
+    }
+
+    bool key(int32_t keycode, bool down)
+    {
+        std::lock_guard lock(mutex_);
+        if (!down) {
+            return release_key(keycode);
+        }
+        const bool repeated = !keys_.insert(keycode).second;
+        return transport_.key(keycode, true, modifiers(), repeated);
+    }
+
+    bool relativeMove(int32_t dx, int32_t dy)
+    {
+        std::lock_guard lock(mutex_);
+        return transport_.relative_move(dx, dy, buttons(), modifiers());
+    }
+
+    bool scroll(int32_t dx, int32_t dy)
+    {
+        std::lock_guard lock(mutex_);
+        return transport_.mouse({ CloudMouseAction::Wheel, 640, 360, buttons(), dx, dy, -1, modifiers() });
+    }
+
+    bool releaseAll()
+    {
+        std::lock_guard lock(mutex_);
+        const auto keys = keys_;
+        const auto contacts = contacts_;
+        bool ok = true;
+        for (const auto keycode : keys) {
+            ok = release_key(keycode) && ok;
+        }
+        for (const auto& [contact, position] : contacts) {
+            ok = release_contact(contact) && ok;
+        }
+        return ok;
+    }
+
+private:
+    static bool valid_contact(int32_t contact) { return contact >= 0 && contact <= 2; }
+
+    int32_t buttons() const
+    {
+        int32_t mask = 0;
+        for (const auto& [contact, position] : contacts_) {
+            mask |= 1 << contact;
+        }
+        return mask;
+    }
+
+    int32_t modifiers() const
+    {
+        // CDP modifier bits; virtual-key codes follow the PC Pipeline contract.
+        const auto held = [&](int generic, int left, int right) {
+            return keys_.contains(generic) || keys_.contains(left) || keys_.contains(right);
+        };
+        return (held(18, 164, 165) ? 1 : 0) | (held(17, 162, 163) ? 2 : 0) | ((keys_.contains(91) || keys_.contains(92)) ? 4 : 0)
+               | (held(16, 160, 161) ? 8 : 0);
+    }
+
+    bool release_key(int32_t keycode)
+    {
+        const bool held = keys_.erase(keycode) != 0;
+        if (transport_.key(keycode, false, modifiers(), false)) {
+            return true;
+        }
+        if (held) {
+            keys_.insert(keycode);
+        }
+        return false;
+    }
+
+    bool release_contact(int32_t contact)
+    {
+        const auto it = contacts_.find(contact);
+        if (it == contacts_.end()) {
+            return true;
+        }
+        const auto [x, y] = it->second;
+        if (!transport_.mouse({ CloudMouseAction::Release, x, y, buttons() & ~(1 << contact), 0, 0, contact, modifiers() })) {
+            return false;
+        }
+        contacts_.erase(it);
+        return true;
+    }
+
+    CloudTransport& transport_;
+    std::mutex mutex_;
+    std::map<int32_t, std::pair<int32_t, int32_t>> contacts_;
+    std::set<int32_t> keys_;
+};
diff --git a/agent/cpp-algo/cloud-webview/transport/cloud_transport.h b/agent/cpp-algo/cloud-webview/transport/cloud_transport.h
new file mode 100644
index 0000000000000000000000000000000000000000..6f294e9b90d07f6bbec1a9e811fa95a6d3ca0a14
--- /dev/null
+++ b/agent/cpp-algo/cloud-webview/transport/cloud_transport.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+enum class CloudMouseAction
+{
+    Press,
+    Release,
+    Move,
+    Wheel,
+};
+
+struct CloudMouseEvent
+{
+    CloudMouseAction action;
+    // Logical 1280x720 page coordinates, independent of host window/DPI.
+    int32_t x = 0;
+    int32_t y = 0;
+    // Left/right/middle are bits 0/1/2; contact -1 means no changed button.
+    int32_t buttons = 0;
+    int32_t delta_x = 0;
+    int32_t delta_y = 0;
+    int32_t contact = -1;
+    // Alt/Control/Meta/Shift are bits 0/1/2/3, not native OS modifier flags.
+    int32_t modifiers = 0;
+};
+
+struct CloudFrame
+{
+    int32_t width = 0;
+    int32_t height = 0;
+    // Packed, top-down BGR8: width * height * 3 bytes, without row padding.
+    // The adapter owns capture synchronization; output must not alias a buffer
+    // still being written by the host after capture returns.
+    std::vector<uint8_t> pixels;
+};
+
+class CloudTransport
+{
+public:
+    virtual ~CloudTransport() = default;
+    virtual bool connect() = 0;
+    virtual bool capture(CloudFrame& output) = 0;
+    virtual bool mouse(const CloudMouseEvent& event) = 0;
+    // Keycodes follow the existing PC Pipeline virtual-key contract. A platform
+    // adapter maps its native key identities; never pass Linux evdev codes here.
+    virtual bool key(int32_t keycode, bool down, int32_t modifiers, bool auto_repeat) = 0;
+    // UTF-8 text, separate from physical key presses.
+    virtual bool insert_text(const std::string& text) = 0;
+    // Signed logical page deltas, not desktop pixels or a duration-based swipe.
+    // A failed call may already have applied input; callers must not replay it.
+    virtual bool relative_move(int32_t dx, int32_t dy, int32_t buttons, int32_t modifiers) = 0;
+};
diff --git a/agent/cpp-algo/cloud-webview/transport/win_cloud_transport.cpp b/agent/cpp-algo/cloud-webview/transport/win_cloud_transport.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3717ccf0f1eb9328b42d6b37f4d12fcb3fec3df7
--- /dev/null
+++ b/agent/cpp-algo/cloud-webview/transport/win_cloud_transport.cpp
@@ -0,0 +1,145 @@
+#include "win_cloud_transport.h"
+
+#include <memory>
+
+#include <MaaUtils/NoWarningCV.hpp>
+
+#include "cloud_protocol.h"
+#include "win_key_identity.h"
+
+namespace
+{
+using Handle = std::unique_ptr<void, decltype(&CloseHandle)>;
+
+const char* button_name(int32_t contact)
+{
+    switch (contact) {
+    case 0:
+        return "left";
+    case 1:
+        return "right";
+    case 2:
+        return "middle";
+    default:
+        return "none";
+    }
+}
+
+}
+
+WinCloudTransport::WinCloudTransport(DWORD process_id, std::function<json::value(const json::value&)> local_input)
+    : process_id_(process_id)
+    , local_input_(std::move(local_input))
+{
+}
+
+bool WinCloudTransport::send(const json::value& body)
+{
+    // A failed input may already have reached the game; never replay it over
+    // the pipe. Remote transports keep the same request protocol as before.
+    if (local_input_) {
+        return local_input_(body).get("ok", false);
+    }
+    const auto result = cloud::Request(process_id_, body);
+    return result && result->get("ok", false);
+}
+
+bool WinCloudTransport::connect()
+{
+    const auto status = cloud::Request(process_id_, json::object { { "op", "status" } });
+    return status && status->get("ok", false);
+}
+
+bool WinCloudTransport::capture(CloudFrame& output)
+{
+    const auto response = cloud::Request(process_id_, json::object { { "op", "frame_shared" } });
+    if (!response || !response->get("ok", false)) {
+        return false;
+    }
+    const auto& frame = response->at("value");
+    const auto mapping_handle = reinterpret_cast<HANDLE>(static_cast<uintptr_t>(frame.at("mapping_handle").as_integer()));
+    const auto width = frame.get("width", 0);
+    const auto height = frame.get("height", 0);
+    const auto stride = frame.get("stride", 0);
+    const auto byte_size = frame.get("byte_size", 0);
+    const Handle mapping(mapping_handle, &CloseHandle);
+    // Protocol v1 always exposes the fixed 720p viewport, independent of DPI.
+    constexpr int kWidth = 1280;
+    constexpr int kHeight = 720;
+    constexpr int kStride = kWidth * 4;
+    constexpr int kFrameBytes = kStride * kHeight;
+    if (!mapping || mapping.get() == INVALID_HANDLE_VALUE || width != kWidth || height != kHeight || stride != kStride
+        || byte_size != kFrameBytes || frame.get("protocol", 0) != 1 || frame.get("format", std::string {}) != "RGBA8") {
+        return false;
+    }
+    const auto pixels = static_cast<const uint8_t*>(MapViewOfFile(mapping.get(), FILE_MAP_READ, 0, 0, byte_size));
+    if (!pixels) {
+        return false;
+    }
+    const auto unmap = [](const uint8_t* address) {
+        UnmapViewOfFile(address);
+    };
+    const std::unique_ptr<const uint8_t, decltype(unmap)> view(pixels, unmap);
+    output.pixels.resize(static_cast<size_t>(width) * height * 3);
+    const cv::Mat rgba(height, width, CV_8UC4, const_cast<uint8_t*>(pixels), stride);
+    cv::Mat bgr(height, width, CV_8UC3, output.pixels.data());
+    cv::cvtColor(rgba, bgr, cv::COLOR_RGBA2BGR);
+    output.width = width;
+    output.height = height;
+    return true;
+}
+
+bool WinCloudTransport::mouse(const CloudMouseEvent& event)
+{
+    const char* type = "mouseMoved";
+    if (event.action == CloudMouseAction::Press) {
+        type = "mousePressed";
+    }
+    else if (event.action == CloudMouseAction::Release) {
+        type = "mouseReleased";
+    }
+    else if (event.action == CloudMouseAction::Wheel) {
+        type = "mouseWheel";
+    }
+    return send(json::object { { "op", "mouse" },
+                               { "params",
+                                 json::object { { "type", type },
+                                                { "x", event.x },
+                                                { "y", event.y },
+                                                { "button",
+                                                  (event.action == CloudMouseAction::Press || event.action == CloudMouseAction::Release)
+                                                      ? button_name(event.contact)
+                                                      : "none" },
+                                                { "buttons", event.buttons },
+                                                { "modifiers", event.modifiers },
+                                                { "deltaX", event.delta_x },
+                                                { "deltaY", event.delta_y },
+                                                { "clickCount", 1 } } } });
+}
+
+bool WinCloudTransport::key(int32_t keycode, bool down, int32_t modifiers, bool auto_repeat)
+{
+    const auto [key, code] = cloud_key_identity(keycode);
+    if (key.empty()) {
+        return false;
+    }
+    return send(json::object { { "op", "key" },
+                               { "params",
+                                 json::object { { "type", down ? "keyDown" : "keyUp" },
+                                                { "key", key },
+                                                { "code", code },
+                                                { "modifiers", modifiers },
+                                                { "autoRepeat", auto_repeat },
+                                                { "windowsVirtualKeyCode", keycode },
+                                                { "nativeVirtualKeyCode", keycode } } } });
+}
+
+bool WinCloudTransport::insert_text(const std::string& text)
+{
+    return send(json::object { { "op", "text" }, { "text", text } });
+}
+
+bool WinCloudTransport::relative_move(int32_t dx, int32_t dy, int32_t buttons, int32_t modifiers)
+{
+    return send(json::object { { "op", "relative" }, { "dx", dx }, { "dy", dy }, { "buttons", buttons }, { "modifiers", modifiers } });
+}
